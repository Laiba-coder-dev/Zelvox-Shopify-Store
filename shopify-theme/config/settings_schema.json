  {
    "name": "Typography",
    "settings": [
      {
        "type": "paragraph",
        "content": "Headings use Space Grotesk and body text uses Inter."
      },
      {
        "type": "range",
        "id": "type_base_size",
        "label": "Base font size",
        "min": 14,
        "max": 18,
        "step": 1,
        "unit": "px",
        "default": 16
      },
      {
        "type": "select",
        "id": "type_heading_transform",
        "label": "Heading capitalization",
        "default": "none",
        "options": [
          { "value": "none", "label": "Normal" },
          { "value": "uppercase", "label": "Uppercase" }
        ]
      },
      {
        "type": "select",
        "id": "type_heading_weight",
        "label": "Heading weight",
        "default": "700",
        "options": [
          { "value": "500", "label": "Medium" },
          { "value": "600", "label": "Semibold" },
          { "value": "700", "label": "Bold" }
        ]
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "label": "Page width",
        "min": 1000,
        "max": 1600,
        "step": 20,
        "unit": "px",
        "default": 1320
      },
      {
        "type": "range",
        "id": "gutter",
