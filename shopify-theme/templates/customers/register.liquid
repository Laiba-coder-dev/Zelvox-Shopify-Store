<section class="section account-page">
  <div class="container container--narrow">
    <header class="page-head">
      <p class="eyebrow">{{ shop.name }}</p>
      <h1 class="page-title">{{ 'customer.register.title' | t }}</h1>
    </header>

    <div class="account-card">
      {%- form 'create_customer' -%}
        {%- if form.errors -%}
          <div class="form-message form-message--error" role="alert" tabindex="-1">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div class="field">
          <label class="field__label" for="FirstName">{{ 'customer.register.first_name' | t }}</label>
          <input class="field__input" type="text" name="customer[first_name]" id="FirstName" autocomplete="given-name">
        </div>

        <div class="field">
          <label class="field__label" for="LastName">{{ 'customer.register.last_name' | t }}</label>
          <input class="field__input" type="text" name="customer[last_name]" id="LastName" autocomplete="family-name">
        </div>

        <div class="field">
          <label class="field__label" for="Email">{{ 'customer.register.email' | t }}</label>
          <input class="field__input" type="email" name="customer[email]" id="Email" autocomplete="email" required>
        </div>

        <div class="field">
          <label class="field__label" for="Password">{{ 'customer.register.password' | t }}</label>
          <input class="field__input" type="password" name="customer[password]" id="Password" autocomplete="new-password" required>
        </div>

        <div class="account-actions-row">
          <button class="btn btn--primary btn--lg" type="submit">{{ 'customer.register.submit' | t }}</button>
          <span class="account-meta">{{ 'customer.register.have_account' | t }}</span>
          <a href="{{ routes.account_login_url }}">{{ 'customer.register.sign_in' | t }}</a>
        </div>
      {%- endform -%}
    </div>
  </div>
</section>
