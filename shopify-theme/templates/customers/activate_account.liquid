<section class="section account-page">
  <div class="container container--narrow">
    <header class="page-head">
      <p class="eyebrow">{{ shop.name }}</p>
      <h1 class="page-title">{{ 'customer.activate_account.title' | t }}</h1>
      <p class="account-meta">{{ 'customer.activate_account.lede' | t }}</p>
    </header>

    <div class="account-card">
      {%- form 'activate_customer_password' -%}
        {%- if form.errors -%}
          <div class="form-message form-message--error" role="alert" tabindex="-1">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div class="field">
          <label class="field__label" for="ActivatePassword">{{ 'customer.activate_account.password' | t }}</label>
          <input class="field__input" type="password" name="customer[password]" id="ActivatePassword" autocomplete="new-password" required>
        </div>

        <div class="field">
          <label class="field__label" for="ActivatePasswordConfirm">{{ 'customer.activate_account.password_confirm' | t }}</label>
          <input class="field__input" type="password" name="customer[password_confirmation]" id="ActivatePasswordConfirm" autocomplete="new-password" required>
        </div>

        <div class="account-actions-row">
          <button class="btn btn--primary btn--lg" type="submit">{{ 'customer.activate_account.submit' | t }}</button>
          <button class="btn btn--outline" type="submit" name="decline">{{ 'customer.activate_account.cancel' | t }}</button>
        </div>
      {%- endform -%}
    </div>
  </div>
</section>
