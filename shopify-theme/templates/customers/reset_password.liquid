<section class="section account-page">
  <div class="container container--narrow">
    <header class="page-head">
      <p class="eyebrow">{{ shop.name }}</p>
      <h1 class="page-title">{{ 'customer.reset_password.title' | t }}</h1>
      <p class="account-meta">{{ 'customer.reset_password.lede' | t: email: email }}</p>
    </header>

    <div class="account-card">
      {%- form 'reset_customer_password' -%}
        {%- if form.errors -%}
          <div class="form-message form-message--error" role="alert" tabindex="-1">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div class="field">
          <label class="field__label" for="ResetPassword">{{ 'customer.reset_password.password' | t }}</label>
          <input class="field__input" type="password" name="customer[password]" id="ResetPassword" autocomplete="new-password" required>
        </div>

        <div class="field">
          <label class="field__label" for="ResetPasswordConfirm">{{ 'customer.reset_password.password_confirm' | t }}</label>
          <input class="field__input" type="password" name="customer[password_confirmation]" id="ResetPasswordConfirm" autocomplete="new-password" required>
        </div>

        <button class="btn btn--primary btn--lg" type="submit">{{ 'customer.reset_password.submit' | t }}</button>
      {%- endform -%}
    </div>
  </div>
</section>
