<section class="section">
  <div class="container container--narrow">
    <header class="page-head page-head--center">
      <p class="eyebrow">{{ 'pages.faqs.eyebrow' | t }}</p>
      <h1 class="page-title">{{ page.title | default: 'Frequently asked questions' }}</h1>
      <p class="page-head__lede">{{ 'pages.faqs.lede' | t }}</p>
    </header>

    <div class="faq-groups">
      {%- assign q_index = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'category' -%}
          <h2 class="faq-group__title" {{ block.shopify_attributes }}>{{ block.settings.heading }}</h2>
        {%- elsif block.type == 'question' -%}
          {%- assign q_index = q_index | plus: 1 -%}
          <details class="faq-item" {{ block.shopify_attributes }}>
            <summary class="faq-item__summary">
              <span class="faq-item__q">{{ block.settings.question }}</span>
              <span class="faq-item__icon" aria-hidden="true"></span>
            </summary>
            <div class="faq-item__body rte">
              {{ block.settings.answer }}
            </div>
          </details>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if page.content != blank -%}
      <div class="rte faq-extra" data-reveal>{{ page.content }}</div>
    {%- endif -%}

    <div class="faq-cta" data-reveal>
      <h2 class="faq-cta__title">{{ 'pages.faqs.contact_prompt' | t }}</h2>
      <p class="faq-cta__text">{{ 'pages.faqs.contact_text' | t }}</p>
      <a href="{{ routes.root_url | append: 'pages/contact-us' }}" class="btn btn--primary">{{ 'pages.faqs.contact_cta' | t }}</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FAQ page",
  "settings": [],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Category" }
      ]
    },
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Your question?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Your answer.</p>" }
      ]
    }
  ],
  "max_blocks": 60,
  "presets": [{ "name": "FAQ page" }]
}
{% endschema %}
