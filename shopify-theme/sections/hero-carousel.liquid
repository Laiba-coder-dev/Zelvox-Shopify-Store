{%- liquid
  assign slide_count = section.blocks.size
  assign height = section.settings.height | default: 'medium'
  assign align = section.settings.text_align | default: 'left'
  assign autoplay_interval = section.settings.interval | times: 1000
  assign transition = section.settings.transition | default: 'cinematic'
-%}
<section
  class="hero hero--{{ height }} hero--transition-{{ transition }}"
  id="Hero-{{ section.id }}"
  data-carousel
  data-autoplay="{{ section.settings.autoplay }}"
  data-interval="{{ autoplay_interval }}"
  data-pause-hover="{{ section.settings.pause_on_hover }}"
  data-pause-focus="{{ section.settings.pause_on_focus }}"
  data-announce-template="{{ 'general.accessibility.slide_announce' | t: number: '[number]', total: '[total]', heading: '[heading]' | escape }}"
  aria-roledescription="carousel"
  aria-label="{{ section.settings.accessibility_label | default: 'Zelvox highlights' | escape }}"
>
  <div class="hero__viewport">
    {%- if slide_count > 0 -%}
      {%- for block in section.blocks -%}
        <div
          class="hero__slide{% if forloop.first %} is-active{% endif %}"
          data-slide
          data-slide-index="{{ forloop.index0 }}"
          aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"
          {{ block.shopify_attributes }}
        >
          <div class="hero__media">
            {%- if block.settings.image != blank -%}
              <picture>
                {%- if block.settings.image_mobile != blank -%}
                  <source
                    media="(max-width: 749px)"
                    srcset="{{ block.settings.image_mobile | image_url: width: 750 }} 750w, {{ block.settings.image_mobile | image_url: width: 1000 }} 1000w"
                    sizes="100vw"
                  >
                {%- endif -%}
                <img
                  class="hero__img"
                  src="{{ block.settings.image | image_url: width: 2400 }}"
                  srcset="{{ block.settings.image | image_url: width: 750 }} 750w, {{ block.settings.image | image_url: width: 1100 }} 1100w, {{ block.settings.image | image_url: width: 1550 }} 1550w, {{ block.settings.image | image_url: width: 2400 }} 2400w"
                  sizes="100vw"
                  width="2400"
                  height="1350"
                  alt="{{ block.settings.image.alt | escape }}"
                  {% if forloop.first %}loading="eager" fetchpriority="high"{% else %}loading="lazy"{% endif %}
                  decoding="async"
                >
              </picture>
            {%- else -%}
              <span class="hero__glow hero__glow--1" aria-hidden="true"></span>
              <span class="hero__glow hero__glow--2" aria-hidden="true"></span>
              <span class="hero__pattern" aria-hidden="true"></span>
            {%- endif -%}
            <span class="hero__grain" aria-hidden="true"></span>
          </div>

          {%- if section.settings.show_devices -%}
            {%- assign device_uid = section.id | append: '-' | append: forloop.index0 -%}
            {%- render 'hero-device-stage',
              visual: block.settings.visual,
              uid: device_uid,
              align: align
            -%}
          {%- endif -%}

          <span class="hero__scrim" aria-hidden="true"></span>

          <div class="container hero__content hero__content--{{ align }}">
            {%- if block.settings.eyebrow != blank -%}
              <p class="eyebrow eyebrow--pill hero__reveal" style="--reveal-i: 0;">{{ block.settings.eyebrow }}</p>
            {%- endif -%}
            {%- capture heading_tag -%}
              {%- if forloop.first -%}h1{%- else -%}h2{%- endif -%}
            {%- endcapture -%}
            <{{ heading_tag | strip }} class="hero__title hero__reveal" style="--reveal-i: 1;">{{ block.settings.heading }}</{{ heading_tag | strip }}>
            {%- if block.settings.text != blank -%}
              <p class="hero__text hero__reveal" style="--reveal-i: 2;">{{ block.settings.text }}</p>
            {%- endif -%}
            {%- if block.settings.primary_label != blank or block.settings.secondary_label != blank -%}
              <div class="hero__actions hero__reveal" style="--reveal-i: 3;">
                {%- if block.settings.primary_label != blank -%}
                  <a class="btn btn--primary btn--lg" href="{{ block.settings.primary_link | default: routes.all_products_collection_url }}">
                    <span>{{ block.settings.primary_label }}</span>
                    {%- render 'icon', name: 'arrow-right', size: 18 -%}
                  </a>
                {%- endif -%}
                {%- if block.settings.secondary_label != blank -%}
                  <a class="btn btn--ghost btn--lg" href="{{ block.settings.secondary_link | default: routes.all_products_collection_url }}">
                    {{ block.settings.secondary_label }}
                  </a>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    {%- else -%}
      <div class="hero__slide is-active" data-slide data-slide-index="0" aria-hidden="false">
        <div class="hero__media">
          <span class="hero__glow hero__glow--1" aria-hidden="true"></span>
          <span class="hero__glow hero__glow--2" aria-hidden="true"></span>
          <span class="hero__pattern" aria-hidden="true"></span>
          <span class="hero__grain" aria-hidden="true"></span>
        </div>
        {%- if section.settings.show_devices -%}
          {%- render 'hero-device-stage', visual: 'smartphone', uid: section.id, align: align -%}
        {%- endif -%}
        <span class="hero__scrim" aria-hidden="true"></span>
        <div class="container hero__content hero__content--{{ align }}">
          <p class="eyebrow eyebrow--pill hero__reveal" style="--reveal-i: 0;">Zelvox</p>
          <h1 class="hero__title hero__reveal" style="--reveal-i: 1;">Technology that feels exceptional.</h1>
          <p class="hero__text hero__reveal" style="--reveal-i: 2;">Premium smartphones, audio and smart devices — engineered, tested and backed by Zelvox.</p>
          <div class="hero__actions hero__reveal" style="--reveal-i: 3;">
            <a class="btn btn--primary btn--lg" href="{{ routes.all_products_collection_url }}">
              <span>Shop all gadgets</span>
              {%- render 'icon', name: 'arrow-right', size: 18 -%}
            </a>
          </div>
        </div>
      </div>
    {%- endif -%}
  </div>

  {%- if slide_count > 1 -%}
    {%- if section.settings.show_arrows -%}
      <button class="hero__arrow hero__arrow--prev" type="button" data-carousel-prev aria-label="{{ 'general.accessibility.previous_slide' | t }}">
        {%- render 'icon', name: 'chevron-left', size: 20 -%}
      </button>
      <button class="hero__arrow hero__arrow--next" type="button" data-carousel-next aria-label="{{ 'general.accessibility.next_slide' | t }}">
        {%- render 'icon', name: 'chevron-right', size: 20 -%}
      </button>
    {%- endif -%}
    {%- if section.settings.show_dots -%}
      <div class="hero__dots" role="tablist" aria-label="{{ 'general.accessibility.slides' | t }}">
        {%- for block in section.blocks -%}
          <button
            class="hero__dot{% if forloop.first %} is-active{% endif %}"
            type="button"
            role="tab"
            data-dot="{{ forloop.index0 }}"
            aria-label="{{ 'general.accessibility.go_to_slide' | t: number: forloop.number }}"
            aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
          ></button>
        {%- endfor -%}
      </div>
    {%- endif -%}
    {%- if section.settings.autoplay -%}
      <button
        class="hero__playpause"
        type="button"
        data-carousel-toggle
        aria-pressed="false"
        aria-label="{{ 'general.accessibility.pause_slideshow' | t }}"
        data-label-pause="{{ 'general.accessibility.pause_slideshow' | t | escape }}"
        data-label-play="{{ 'general.accessibility.play_slideshow' | t | escape }}"
      >
        {%- render 'icon', name: 'pause', size: 16 -%}
      </button>
    {%- endif -%}
  {%- endif -%}

  <p class="visually-hidden" aria-live="polite" data-carousel-status></p>
</section>

{% schema %}
{
  "name": "Hero carousel",
  "max_blocks": 6,
  "settings": [
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "default": "medium",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ]
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text alignment",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ]
    },
    {
      "type": "header",
      "content": "Slideshow"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-rotate slides",
      "default": true
    },
    {
      "type": "range",
      "id": "interval",
      "label": "Change slides every",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 3
    },
    {
      "type": "select",
      "id": "transition",
      "label": "Transition style",
      "default": "cinematic",
      "options": [
        { "value": "cinematic", "label": "Cinematic crossfade with zoom" },
        { "value": "simple", "label": "Simple fade" }
      ]
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause while hovering",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "pause_on_focus",
      "label": "Pause while navigating with keyboard",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show slide indicators",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show arrows",
      "default": true
    },
    {
      "type": "header",
      "content": "3D device visuals"
    },
    {
      "type": "checkbox",
      "id": "show_devices",
      "label": "Show floating gadget visuals",
      "info": "Lightweight CSS 3D renders. Each slide picks its composition below.",
      "default": true
    },
    {
      "type": "header",
      "content": "Accessibility"
    },
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Carousel label",
      "default": "Zelvox highlights"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "header",
          "content": "Image"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Background image",
          "info": "Recommended 2400 × 1350px. Leave empty to use the built-in gradient scene."
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Mobile background image",
          "info": "Optional. Shown below 750px for a faster, better-composed mobile hero."
        },
        {
          "type": "select",
          "id": "visual",
          "label": "Floating gadget composition",
          "default": "smartphone",
          "options": [
            { "value": "smartphone", "label": "Phone, earbuds & charger" },
            { "value": "smart-home", "label": "Watch, headphones & smart home" },
            { "value": "gaming", "label": "Headset, keyboard, mouse & controller" },
            { "value": "launch", "label": "New-release launch scene" },
            { "value": "none", "label": "None" }
          ]
        },
        {
          "type": "header",
          "content": "Content"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow text",
          "default": "New generation"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Technology, Elevated."
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Discover the devices shaping the way you live, work, and create."
        },
        {
          "type": "header",
          "content": "Buttons"
        },
        {
          "type": "text",
          "id": "primary_label",
          "label": "Primary button label",
          "default": "Explore Collection"
        },
        {
          "type": "url",
          "id": "primary_link",
          "label": "Primary button link"
        },
        {
          "type": "text",
          "id": "secondary_label",
          "label": "Secondary button label"
        },
        {
          "type": "url",
          "id": "secondary_link",
          "label": "Secondary button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero carousel",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "eyebrow": "New generation",
            "heading": "Technology, Elevated.",
            "text": "Discover the devices shaping the way you live, work, and create.",
            "primary_label": "Explore Collection",
            "visual": "smartphone"
          }
        },
        {
          "type": "slide",
          "settings": {
            "eyebrow": "Smart living",
            "heading": "Smarter Living Starts Here",
            "text": "Wearables, audio and smart-home devices that work together — and with everything else you own.",
            "primary_label": "Shop Smart Devices",
            "visual": "smart-home"
          }
        },
        {
          "type": "slide",
          "settings": {
            "eyebrow": "Gaming gear",
            "heading": "Built for Your Next Level",
            "text": "Headsets, keyboards, mice and controllers engineered for the sessions that matter.",
            "primary_label": "Explore Gaming",
            "visual": "gaming"
          }
        },
        {
          "type": "slide",
          "settings": {
            "eyebrow": "Just landed",
            "heading": "Meet What's Next",
            "text": "The newest gadgets, unboxed and tested by the Zelvox team.",
            "primary_label": "Shop New Arrivals",
            "visual": "launch"
          }
        }
      ]
    }
  ]
}
{% endschema %}
