{%- liquid
  assign align = section.settings.content_align | default: 'left'
-%}
<section class="section section--promo" id="Section-{{ section.id }}">
  <div class="container">
    <div class="promo promo--{{ align }}">
      <div class="promo__media">
        {%- if section.settings.image != blank -%}
          <img
            class="promo__img"
            src="{{ section.settings.image | image_url: width: 2200 }}"
            srcset="{{ section.settings.image | image_url: width: 750 }} 750w, {{ section.settings.image | image_url: width: 1100 }} 1100w, {{ section.settings.image | image_url: width: 1600 }} 1600w, {{ section.settings.image | image_url: width: 2200 }} 2200w"
            sizes="(min-width: 1320px) 1320px, 100vw"
            width="2200"
            height="900"
            alt="{{ section.settings.image.alt | escape }}"
            loading="lazy"
          >
        {%- else -%}
          <span class="promo__glow promo__glow--1" aria-hidden="true"></span>
          <span class="promo__glow promo__glow--2" aria-hidden="true"></span>
          <span class="promo__pattern" aria-hidden="true"></span>
        {%- endif -%}
      </div>
      <span class="promo__scrim" aria-hidden="true"></span>

      <div class="promo__content reveal-self" data-reveal>
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow eyebrow--pill">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="promo__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <p class="promo__text">{{ section.settings.text }}</p>
        {%- endif -%}
        {%- if section.settings.primary_label != blank or section.settings.secondary_label != blank -%}
          <div class="promo__actions">
            {%- if section.settings.primary_label != blank -%}
              <a class="btn btn--primary btn--lg" href="{{ section.settings.primary_link | default: routes.all_products_collection_url }}">
                <span>{{ section.settings.primary_label }}</span>
                {%- render 'icon', name: 'arrow-right', size: 18 -%}
              </a>
            {%- endif -%}
            {%- if section.settings.secondary_label != blank -%}
              <a class="btn btn--ghost btn--lg" href="{{ section.settings.secondary_link | default: routes.all_products_collection_url }}">
                {{ section.settings.secondary_label }}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Promotional banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image",
      "info": "A gradient placeholder is used when no image is selected."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Limited time"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Upgrade your setup for less"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Save up to 40% on selected audio, wearables and gaming gear. While stock lasts, with the same Zelvox warranty on every order."
    },
    {
      "type": "select",
      "id": "content_align",
      "label": "Content alignment",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ]
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button label",
      "default": "Shop the deals"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button label",
      "default": "See all offers"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary button link"
    }
  ],
  "presets": [
    {
      "name": "Promotional banner"
    }
  ]
}
{% endschema %}
