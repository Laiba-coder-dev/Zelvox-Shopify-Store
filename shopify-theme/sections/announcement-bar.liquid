{%- if section.settings.text != blank -%}
  <div class="announcement" data-announcement>
    <div class="container announcement__inner">
      {%- if section.settings.link != blank -%}
        <a href="{{ section.settings.link }}" class="announcement__link">
          <span>{{ section.settings.text }}</span>
          {%- render 'icon', name: 'arrow-right', size: 14 -%}
        </a>
      {%- else -%}
        <p class="announcement__text">{{ section.settings.text }}</p>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Free express shipping over $99 · 30-day easy returns · 2-year Zelvox warranty"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    }
  ],
  "presets": [
    {
      "name": "Announcement bar"
    }
  ]
}
{% endschema %}
