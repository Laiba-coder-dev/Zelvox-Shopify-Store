<section class="section" id="ContactSection-{{ section.id }}">
  <div class="container container--narrow">
    <header class="page-head page-head--center">
      <p class="eyebrow">{{ 'pages.contact.eyebrow' | t }}</p>
      <h1 class="page-title">{{ page.title | default: 'Contact us' }}</h1>
      <p class="page-head__lede">{{ 'pages.contact.lede' | t }}</p>
    </header>

    <div class="contact-grid">
      <div class="contact-panel">
        <h2 class="contact-panel__title">{{ 'pages.contact.form_heading' | t }}</h2>

        {%- if form.posted_successfully? -%}
          <div class="form-message form-message--success" role="status" tabindex="-1" data-contact-success>
            <p>{{ 'pages.contact.success' | t }}</p>
          </div>
        {%- endif -%}

        {%- if form.errors -%}
          <div class="form-message form-message--error" role="alert" tabindex="-1" data-contact-errors>
            <p><strong>{{ 'pages.contact.errors_heading' | t }}</strong></p>
            <ul>
              {%- for field in form.errors -%}
                <li><a href="#Contact-{{ field }}">{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}</a></li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        {%- form 'contact', id: 'ContactForm', class: 'contact-form', novalidate: 'novalidate' -%}
          <div class="contact-form__row contact-form__row--2">
            <div class="field">
              <label class="field__label" for="Contact-name">{{ 'pages.contact.name' | t }} <span aria-hidden="true">*</span></label>
              <input class="field__input" type="text" id="Contact-name" name="contact[name]" autocomplete="name" required aria-required="true" aria-describedby="Contact-name-error">
              <p class="field__error" id="Contact-name-error" role="alert" hidden>{{ 'pages.contact.err_name' | t }}</p>
            </div>
            <div class="field">
              <label class="field__label" for="Contact-email">{{ 'pages.contact.email' | t }} <span aria-hidden="true">*</span></label>
              <input class="field__input" type="email" id="Contact-email" name="contact[email]" autocomplete="email" required aria-required="true" aria-describedby="Contact-email-error">
              <p class="field__error" id="Contact-email-error" role="alert" hidden></p>
            </div>
          </div>

          <div class="field">
            <label class="field__label" for="Contact-subject">{{ 'pages.contact.subject' | t }} <span aria-hidden="true">*</span></label>
            <input class="field__input" type="text" id="Contact-subject" name="contact[subject]" required aria-required="true" aria-describedby="Contact-subject-error">
            <p class="field__error" id="Contact-subject-error" role="alert" hidden>{{ 'pages.contact.err_subject' | t }}</p>
          </div>

          <div class="field field--textarea">
            <label class="field__label" for="Contact-body">{{ 'pages.contact.message' | t }} <span aria-hidden="true">*</span></label>
            <textarea class="field__input" id="Contact-body" name="contact[body]" rows="6" required aria-required="true" aria-describedby="Contact-body-error"></textarea>
            <p class="field__error" id="Contact-body-error" role="alert" hidden>{{ 'pages.contact.err_message' | t }}</p>
          </div>

          <p class="contact-form__note">{{ 'pages.contact.form_note' | t }}</p>

          <button type="submit" class="btn btn--primary contact-form__submit">{{ 'pages.contact.send' | t }}</button>
        {%- endform -%}
      </div>

      <aside class="contact-details">
        <h2 class="contact-details__title">{{ 'pages.contact.details_heading' | t }}</h2>
        <ul class="contact-details__list">
          {%- if shop.email != blank -%}
            <li class="contact-detail">
              <span class="contact-detail__label">{{ 'pages.contact.email_label' | t }}</span>
              <a href="mailto:{{ shop.email }}">{{ shop.email }}</a>
            </li>
          {%- endif -%}
          {%- if shop.phone != blank -%}
            <li class="contact-detail">
              <span class="contact-detail__label">{{ 'pages.contact.phone_label' | t }}</span>
              <a href="tel:{{ shop.phone | remove: ' ' }}">{{ shop.phone }}</a>
            </li>
          {%- endif -%}
          {%- if section.settings.show_social -%}
            {%- if section.settings.social_instagram != blank or section.settings.social_x != blank or section.settings.social_youtube != blank -%}
              <li class="contact-detail">
                <span class="contact-detail__label">Social</span>
                <div class="contact-social">
                  {%- if section.settings.social_instagram != blank -%}<a href="{{ section.settings.social_instagram }}" target="_blank" rel="noopener">Instagram</a>{%- endif -%}
                  {%- if section.settings.social_x != blank -%}<a href="{{ section.settings.social_x }}" target="_blank" rel="noopener">X</a>{%- endif -%}
                  {%- if section.settings.social_youtube != blank -%}<a href="{{ section.settings.social_youtube }}" target="_blank" rel="noopener">YouTube</a>{%- endif -%}
                </div>
              </li>
            {%- endif -%}
          {%- endif -%}
        </ul>
      </aside>
    </div>
  </div>
</section>

<script>
  (function () {
    function init() {
      var section = document.getElementById('ContactSection-{{ section.id }}');
      if (!section) return;
      var form = section.querySelector('form[data-form="contact"]');
      if (!form) return;

      /* Keep the post target on this page. On a real store Shopify handles the
         POST and sets form.posted_successfully? on return, so the success
         banner only ever reflects a real submission. */
      form.setAttribute('action', window.location.pathname);

      var emailRe = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

      function fieldError(input, on, key) {
        var box = input.parentNode.querySelector('.field__error');
        if (!box) return;
        if (on) {
          if (key) box.textContent = key;
          box.hidden = false;
          input.setAttribute('aria-invalid', 'true');
        } else {
          box.hidden = true;
          input.removeAttribute('aria-invalid');
        }
      }

      var name = form.querySelector('#Contact-name');
      var email = form.querySelector('#Contact-email');
      var subject = form.querySelector('#Contact-subject');
      var body = form.querySelector('#Contact-body');

      [name, email, subject, body].forEach(function (el) {
        if (!el) return;
        el.addEventListener('input', function () { fieldError(el, false); });
      });

      form.addEventListener('submit', function (e) {
        var ok = true, first = null;
        var errName = {{ 'pages.contact.err_name' | t | json }};
        var errEmail = {{ 'pages.contact.err_email' | t | json }};
        var errEmailInvalid = {{ 'pages.contact.err_email_invalid' | t | json }};
        var errSubject = {{ 'pages.contact.err_subject' | t | json }};
        var errMessage = {{ 'pages.contact.err_message' | t | json }};

        function check(el, valid, msg) {
          fieldError(el, !valid, msg);
          if (!valid) { ok = false; if (!first) first = el; }
        }

        check(name, name.value.trim().length > 0, errName);
        check(email, emailRe.test(email.value.trim()), email.value.trim() ? errEmailInvalid : errEmail);
        check(subject, subject.value.trim().length > 0, errSubject);
        check(body, body.value.trim().length > 0, errMessage);

        if (!ok) {
          e.preventDefault();
          if (first) first.focus();
        }
      });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
    else init();
  })();
</script>

{% schema %}
{
  "name": "Contact form",
  "settings": [
    { "type": "checkbox", "id": "show_social", "label": "Show social links", "default": false, "info": "Only shown when at least one real URL below is set." },
    { "type": "url", "id": "social_instagram", "label": "Instagram URL" },
    { "type": "url", "id": "social_x", "label": "X URL" },
    { "type": "url", "id": "social_youtube", "label": "YouTube URL" }
  ],
  "presets": [{ "name": "Contact form" }]
}
{% endschema %}
