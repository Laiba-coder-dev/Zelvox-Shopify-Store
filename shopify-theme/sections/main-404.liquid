<section class="section">
  <div class="container container--narrow">
    <header class="page-head">
      <p class="eyebrow">{{ shop.name }}</p>
      <h1 class="page-title">{{ 'general.404.title' | t }}</h1>
      <p class="page-lede">{{ 'general.404.subtext' | t }}</p>
    </header>
    <div class="page-head__actions">
      <a class="btn btn--primary" href="{{ routes.root_url }}">
        <span>{{ 'general.404.link' | t }}</span>
        {%- render 'icon', name: 'arrow-right', size: 18 -%}
      </a>
      <a class="btn btn--outline" href="{{ routes.all_products_collection_url }}">
        {{ 'products.collection.view_all' | t }}
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "404",
  "settings": []
}
{% endschema %}
