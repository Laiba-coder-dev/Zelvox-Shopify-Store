{%- comment -%}
  Cart drawer. Server-rendered initial state from `cart`, then kept in sync by
  theme.js via Shopify's Ajax Cart API (/cart/add.js, /cart/change.js, /cart.js).
  Checkout always hands off to real Shopify checkout.
{%- endcomment -%}
<div class="cart-drawer" id="ZelvoxCartDrawer" data-cart-drawer aria-hidden="true">
  <div class="cart-drawer__backdrop" data-cart-drawer-close></div>
  <aside
    class="cart-drawer__panel"
    role="dialog"
    aria-modal="true"
    aria-label="{{ 'templates.cart.title' | t }}"
    tabindex="-1"
    data-cart-drawer-panel
  >
    <header class="cart-drawer__head">
      <h2 class="cart-drawer__title">
        {{ 'templates.cart.title' | t }}
        <span class="cart-drawer__count" data-cart-drawer-count>({{ cart.item_count }})</span>
      </h2>
      <button class="icon-btn" type="button" data-cart-drawer-close>
        {%- render 'icon', name: 'close', size: 22 -%}
        <span class="visually-hidden">{{ 'general.accessibility.close' | t }}</span>
      </button>
    </header>

    <div class="cart-drawer__body" data-cart-drawer-body>
      {%- if cart.item_count > 0 -%}
        <ul class="cart-drawer__list" data-cart-drawer-list>
          {%- for item in cart.items -%}
            <li class="cart-drawer__item" data-cart-item data-key="{{ item.key }}" data-variant-id="{{ item.variant.id }}">
              <a class="cart-drawer__media" href="{{ item.url }}">
                {%- if item.image -%}
                  <img src="{{ item.image | image_url: width: 200 }}" width="200" height="200" alt="{{ item.title | escape }}" loading="lazy">
                {%- else -%}
                  <span class="cart-item__placeholder">{%- render 'icon', name: 'bolt', size: 22 -%}</span>
                {%- endif -%}
              </a>
              <div class="cart-drawer__details">
                <a class="cart-drawer__item-title" href="{{ item.url }}">{{ item.product.title }}</a>
                {%- unless item.product.has_only_default_variant -%}
                  <p class="cart-drawer__variant">{{ item.variant.title }}</p>
                {%- endunless -%}
                <p class="cart-drawer__price">{{ item.final_price | money }}</p>
                <div class="cart-drawer__controls">
                  <div class="qty-field qty-field--sm">
                    <label class="visually-hidden" for="DrawerQty-{{ item.key }}">{{ 'templates.cart.quantity' | t }}</label>
                    <input
                      class="qty-field__input"
                      id="DrawerQty-{{ item.key }}"
                      type="number"
                      name="quantity"
                      value="{{ item.quantity }}"
                      min="0"
                      data-cart-item-qty
                      data-key="{{ item.key }}"
                      inputmode="numeric"
                    >
                  </div>
                  <button class="cart-drawer__remove" type="button" data-cart-item-remove data-key="{{ item.key }}">
                    {{ 'templates.cart.remove' | t }}
                  </button>
                </div>
              </div>
              <p class="cart-drawer__line-price" data-cart-line-price>{{ item.final_line_price | money }}</p>
            </li>
          {%- endfor -%}
        </ul>
      {%- else -%}
        <div class="cart-drawer__empty" data-cart-drawer-empty>
          <span class="empty-state__icon" aria-hidden="true">{%- render 'icon', name: 'bag', size: 28 -%}</span>
          <p class="empty-state__text">{{ 'templates.cart.empty' | t }}</p>
          <a class="btn btn--outline btn--sm" href="{{ routes.all_products_collection_url }}" data-cart-drawer-close>
            {{ 'templates.cart.continue_shopping' | t }}
          </a>
        </div>
      {%- endif -%}
    </div>

    <footer class="cart-drawer__foot" data-cart-drawer-foot {% if cart.item_count == 0 %}hidden{% endif %}>
      <div class="cart-drawer__note">
        <label class="visually-hidden" for="CartDrawerNote">{{ 'templates.cart.note' | t }}</label>
        <textarea
          class="cart-drawer__note-input"
          id="CartDrawerNote"
          name="note"
          placeholder="{{ 'templates.cart.note_placeholder' | t }}"
          data-cart-note
        >{{ cart.note }}</textarea>
      </div>
      <div class="cart-drawer__subtotal">
        <span>{{ 'templates.cart.subtotal' | t }}</span>
        <strong data-cart-drawer-subtotal>{{ cart.total_price | money }}</strong>
      </div>
      <p class="cart-drawer__hint">{{ 'templates.cart.taxes_and_shipping' | t }}</p>
      <a class="btn btn--primary btn--lg cart-drawer__checkout" href="/checkout" data-cart-checkout>
        <span>{{ 'templates.cart.checkout' | t }}</span>
        {%- render 'icon', name: 'lock', size: 16 -%}
      </a>
      <a class="cart-drawer__view-cart" href="{{ routes.cart_url }}">{{ 'templates.cart.view_cart' | t }}</a>
    </footer>
  </aside>
</div>
