# --- Database ---------------------------------------------------------------
# SQLite file used by Prisma (relative to prisma/).
DATABASE_URL="file:./dev.db"

# --- App --------------------------------------------------------------------
# Public URL used in emails, sitemap and metadata.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Security ---------------------------------------------------------------
# HMAC secret for admin session cookies. Generate a new random value per
# environment: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# --- Administrator account (created by prisma/seed.ts) ----------------------
ADMIN_EMAIL="admin@example.com"
ADMIN_NAME="Administrator"
ADMIN_PASSWORD="ChangeMe123!"

# --- Email (nodemailer SMTP) ------------------------------------------------
# Leave SMTP_HOST empty to disable outbound email. The admin dashboard then
# reports "Email notifications not configured" — nothing is faked.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="quotes@example.com"
ADMIN_NOTIFY_EMAIL="sales@example.com"
