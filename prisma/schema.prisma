generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Administration
// ---------------------------------------------------------------------------

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         String    @default("admin") // admin | manager | viewer
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?
  sessions     Session[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime
}

// ---------------------------------------------------------------------------
// Catalogue
// ---------------------------------------------------------------------------

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  products    Product[]
}

model Product {
  id              String          @id @default(cuid())
  name            String
  slug            String          @unique
  sku             String          @unique
  categoryId      String
  category        Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  shortDesc       String
  description     String
  moq             String
  leadTime        String
  packaging       String
  customization   String?
  materials       String?
  dimensions      String?
  options         ProductOption[]
  specifications  ProductSpec[]
  images          ProductImage[]
  // Pricing: B2B pricing is negotiated. The administrator may publish an
  // indicative price; when nothing is published visitors see "Request a Quote".
  pricePublished  Boolean         @default(false)
  priceAmount     Float?
  priceUnit       String?
  priceCurrency   String          @default("GBP")
  featured        Boolean         @default(false)
  status          String          @default("active") // active | draft | archived
  sortOrder       Int             @default(0)
  searchKeywords  String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  inquiryItems    InquiryItem[]
}

model ProductOption {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String // e.g. "GSM", "Size", "Grade"
  values    String // comma separated values
  sortOrder Int     @default(0)
}

model ProductSpec {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  label     String
  value     String
  sortOrder Int     @default(0)
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  path      String // path inside the uploads directory, served by /api/media
  alt       String?
  sortOrder Int     @default(0)
}

// ---------------------------------------------------------------------------
// Leads: bulk inquiries, contact messages, callback + sample requests
// ---------------------------------------------------------------------------

model Inquiry {
  id              String              @id @default(cuid())
  reference       String              @unique
  kind            String              @default("inquiry") // inquiry | contact | callback | sample
  company         String
  contactPerson   String
  email           String
  phone           String?
  country         String // United Kingdom | Germany | Other
  otherCountry    String?
  city            String?
  postcode        String?
  address         String?
  shippingMethod  String?
  packaging       String?
  customization   String?
  targetPrice     String?
  notes           String?
  status          String              @default("New")
  adminNotes      String?
  source          String              @default("quote-page") // quote-page | product-page | contact-page | home-cta
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  items           InquiryItem[]
  attachments     InquiryAttachment[]
  events          InquiryEvent[]
  quotations      Quotation[]
}

model InquiryItem {
  id          String   @id @default(cuid())
  inquiryId   String
  inquiry     Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String
  sku         String?
  quantity    String
  packaging   String?
  notes       String?
}

model InquiryAttachment {
  id         String   @id @default(cuid())
  inquiryId  String
  inquiry    Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  filename   String
  storedName String
  mimeType   String
  size       Int
  createdAt  DateTime @default(now())
}

model InquiryEvent {
  id         String   @id @default(cuid())
  inquiryId  String
  inquiry    Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  type       String   @default("status") // status | note | quotation | email
  fromStatus String?
  toStatus   String?
  message    String?
  actor      String?
  createdAt  DateTime @default(now())
}

model EmailLog {
  id         String   @id @default(cuid())
  inquiryId  String?
  to         String
  subject    String
  status     String // sent | failed | skipped-not-configured
  error      String?
  createdAt  DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Quotations (negotiated pricing lives here, not in the public catalogue)
// ---------------------------------------------------------------------------

model Quotation {
  id           String            @id @default(cuid())
  reference    String            @unique
  inquiryId    String
  inquiry      Inquiry           @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  currency     String            @default("GBP")
  status       String            @default("Draft") // Draft | Sent | Under Negotiation | Accepted | Rejected | Expired
  validUntil   DateTime?
  subject      String
  intro        String?
  notes        String?
  terms        String?
  sentAt       DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  lineItems    QuotationLine[]
}

model QuotationLine {
  id            String     @id @default(cuid())
  quotationId   String
  quotation     Quotation  @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  description   String
  quantity      String
  unitPrice     Float
  amount        Float
  sortOrder     Int        @default(0)
}

// ---------------------------------------------------------------------------
// Content / settings
// ---------------------------------------------------------------------------

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Testimonial {
  id            String   @id @default(cuid())
  authorName    String
  authorRole    String?
  company       String?
  country       String?
  content       String
  rating        Int      @default(5)
  published     Boolean  @default(false)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
}
